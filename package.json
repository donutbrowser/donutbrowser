{
  "name": "donutbrowser",
  "private": true,
  "license": "AGPL-3.0",
  "version": "0.35.5",
  "type": "module",
  "scripts": {
    "predev": "pnpm licenses:generate",
    "dev": "next dev --turbopack -p 12341",
    "prebuild": "pnpm licenses:generate",
    "build": "next build",
    "start": "next start",
    "test": "pnpm test:themes && pnpm test:tips && pnpm test:window-decorations && pnpm test:cookie-bot-limits && pnpm test:cookie-bot-outcomes && pnpm test:recipes && pnpm test:agent-console && pnpm test:api-examples && pnpm test:backend-errors && pnpm test:i18n-parity && pnpm test:proxy-string && pnpm test:proxy-type && pnpm test:proxy-first-hop-claims && pnpm test:profile-search && pnpm test:palette-search && pnpm test:ui-sounds && pnpm test:schedules && pnpm test:team-activity && pnpm test:table-tools && pnpm test:motion && pnpm test:donut-lab && pnpm test:profile-store && pnpm test:licenses && pnpm test:xray-packaging && pnpm test:appimage-metainfo && pnpm test:appimage-system-libs && pnpm test:rust:unit && pnpm test:donut-sync && pnpm test:sync-e2e",
    "test:themes": "node --test src/lib/themes.test.mjs",
    "test:tips": "node --test src/lib/tips.test.mjs src/lib/coach-mark.test.mjs",
    "test:window-decorations": "node --test src/lib/window-decorations.test.mjs",
    "test:cookie-bot-limits": "node --test src/lib/cookie-bot-limits.test.mjs src/lib/schedule-layout.test.mjs",
    "test:cookie-bot-outcomes": "node --test src/lib/cookie-bot-outcomes.test.mjs",
    "test:recipes": "node --test src/lib/recipes.test.mjs",
    "test:agent-console": "node --test src/lib/agent-console.test.mjs",
    "test:api-examples": "node --test src/lib/api-examples.test.mjs",
    "test:backend-errors": "node --test src/lib/backend-errors.test.mjs",
    "test:i18n-parity": "node --test src/lib/i18n-parity.test.mjs",
    "test:proxy-string": "node --test src/lib/proxy-string.test.mjs",
    "test:proxy-type": "node --test src/lib/proxy-type.test.mjs",
    "test:proxy-first-hop-claims": "node --test src/lib/proxy-first-hop-claims.test.mjs",
    "test:profile-search": "node --test src/lib/profile-search.test.mjs src/lib/profile-search-suggest.test.mjs",
    "test:palette-search": "node --test src/lib/palette-search.test.mjs src/lib/shortcuts.test.mjs",
    "test:ui-sounds": "node --test src/lib/ui-sounds.test.mjs",
    "test:schedules": "node --test src/lib/schedules.test.mjs",
    "test:team-activity": "node --test src/lib/team-activity.test.mjs",
    "test:motion": "node --test src/lib/motion.test.mjs",
    "test:donut-lab": "node --test src/lib/donut-lab.test.mjs",
    "test:profile-store": "node --test src/lib/profile-list-store.test.mjs src/components/profile-table/traffic-snapshots.test.mjs",
    "test:licenses": "node --test scripts/generate-licenses.test.mjs && node scripts/generate-licenses.mjs --check",
    "test:xray-packaging": "node --test src-tauri/download-xray.test.mjs",
    "test:appimage-metainfo": "node --test scripts/appimage-metainfo.test.mjs",
    "test:appimage-system-libs": "node --test scripts/appimage-system-libs.test.mjs",
    "licenses:generate": "node scripts/generate-licenses.mjs",
    "licenses:check": "node scripts/generate-licenses.mjs --check",
    "test:rust": "cd src-tauri && cargo test",
    "test:donut-sync": "cd donut-sync && cargo test --lib --locked",
    "test:rust:unit": "cd src-tauri && cargo test --lib && cargo test --test donut_proxy_integration && cargo test --test vpn_integration",
    "test:sync-e2e": "node scripts/sync-test-harness.mjs",
    "e2e": "node e2e/run.mjs --suite=full",
    "e2e:smoke": "node e2e/run.mjs --suite=smoke",
    "e2e:ui": "node e2e/run.mjs --suite=ui",
    "e2e:entities": "node e2e/run.mjs --suite=entities",
    "e2e:network": "node e2e/run.mjs --suite=network",
    "e2e:integrations": "node e2e/run.mjs --suite=integrations",
    "e2e:sync": "node e2e/run.mjs --suite=sync",
    "e2e:browser": "node e2e/run.mjs --suite=browser",
    "lint": "pnpm lint:js && pnpm lint:rust && pnpm lint:spell",
    "lint:js": "biome check src/ e2e/ scripts/generate-licenses.mjs scripts/generate-licenses.test.mjs scripts/appimage-metainfo.mjs scripts/appimage-metainfo.test.mjs scripts/appimage-system-libs.mjs scripts/appimage-system-libs.test.mjs scripts/run-with-env.mjs src-tauri/download-xray.mjs src-tauri/download-xray.test.mjs src-tauri/copy-proxy-binary.mjs && tsrs --noEmit",
    "lint:rust": "cd src-tauri && cargo clippy --all-targets --all-features -- -D warnings -D clippy::all && cargo fmt --all && cd ../donut-sync && cargo clippy --all-targets --locked -- -D warnings -D clippy::all && cargo fmt --all",
    "lint:spell": "typos .",
    "tauri": "node scripts/run-with-env.mjs tauri",
    "shadcn:add": "pnpm dlx shadcn@latest add",
    "prepare": "husky",
    "format:rust": "cd src-tauri && cargo clippy --fix --allow-dirty --all-targets --all-features -- -D warnings -D clippy::all && cargo fmt --all && cd ../donut-sync && cargo clippy --fix --allow-dirty --all-targets -- -D warnings -D clippy::all && cargo fmt --all",
    "format:js": "biome check src/ e2e/ --write --unsafe",
    "format": "pnpm format:js && pnpm format:rust",
    "build:sync": "cd donut-sync && cargo build --release --locked",
    "cargo": "cd src-tauri && cargo",
    "unused-exports:js": "ts-unused-exports tsconfig.json",
    "check-unused-commands": "cd src-tauri && cargo test test_no_unused_tauri_commands",
    "copy-proxy-binary": "node src-tauri/copy-proxy-binary.mjs",
    "copy-proxy-binary:release": "node src-tauri/copy-proxy-binary.mjs --release",
    "pretauri:dev": "pnpm copy-proxy-binary",
    "precargo": "pnpm copy-proxy-binary",
    "test:table-tools": "node --test src/lib/table-tools.test.mjs src/components/profile-table/column-fit.test.mjs src/lib/table-views.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-portal": "^1.2.0",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.22",
    "@tanstack/table-core": "9.3.1",
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-autostart": "~2.7.0",
    "@tauri-apps/plugin-clipboard-manager": "~2.5.0",
    "@tauri-apps/plugin-deep-link": "~2.6.2",
    "@tauri-apps/plugin-dialog": "~2.8.3",
    "@tauri-apps/plugin-fs": "~2.7.1",
    "@tauri-apps/plugin-log": "~2.10.1",
    "@tauri-apps/plugin-notification": "~2.7.0",
    "@tauri-apps/plugin-opener": "~2.7.2",
    "ahooks": "^3.10.0",
    "aria-hidden": "1.2.6",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "color": "^5.0.3",
    "flag-icons": "^7.6.0",
    "geist": "1.8.2",
    "i18next": "^26.5.6",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.4",
    "react-icons": "^5.7.0",
    "recharts": "3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tauri-plugin-macos-permissions-api": "^2.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "~2.12.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/color": "^4.2.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "spdx-expression-parse": "5.0.0",
    "tailwindcss": "^4.3.3",
    "ts-unused-exports": "^11.0.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2"
  },
  "packageManager": "pnpm@12.15.0",
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,css}": [
      "biome check --fix"
    ],
    "src-tauri/**/*.rs": [
      "bash -c 'cd src-tauri && cargo fmt --all'",
      "bash -c 'cd src-tauri && cargo clippy --all-targets --all-features -- -D warnings -D clippy::all'",
      "bash -c 'cd src-tauri && cargo test --lib'"
    ],
    "**/*.{rs,ts,tsx,js,jsx,md}": [
      "typos"
    ]
  }
}
